{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqlok.dev/schema/spec-ast/v1.json",
  "title": "SeqlokSpecAstV1",
  "description": "Canonical authored spec AST for Seqlok. This artifact validates authored structure only; semantic compilation, runtime defaults, namespace flattening, planner legality, and compatibility policy belong to @seqlok/core.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "$ref": "#/$defs/ParamNamespace"
    },
    "meters": {
      "$ref": "#/$defs/MeterNamespace"
    }
  },
  "$defs": {
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "EnumVocabulary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ParamNamespace": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ParamNode"
      }
    },
    "MeterNamespace": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/MeterNode"
      }
    },
    "ParamNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/ParamDef"
        },
        {
          "$ref": "#/$defs/ParamNamespace"
        }
      ]
    },
    "MeterNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/MeterDef"
        },
        {
          "$ref": "#/$defs/MeterNamespace"
        }
      ]
    },
    "ParamDef": {
      "oneOf": [
        {
          "$ref": "#/$defs/F32ParamDef"
        },
        {
          "$ref": "#/$defs/I32ParamDef"
        },
        {
          "$ref": "#/$defs/U32ParamDef"
        },
        {
          "$ref": "#/$defs/BoolParamDef"
        },
        {
          "$ref": "#/$defs/EnumParamDef"
        },
        {
          "$ref": "#/$defs/F32ArrayDef"
        },
        {
          "$ref": "#/$defs/I32ArrayDef"
        },
        {
          "$ref": "#/$defs/U32ArrayDef"
        },
        {
          "$ref": "#/$defs/U8ArrayDef"
        },
        {
          "$ref": "#/$defs/I8ArrayDef"
        },
        {
          "$ref": "#/$defs/I16ArrayDef"
        },
        {
          "$ref": "#/$defs/U16ArrayDef"
        },
        {
          "$ref": "#/$defs/BoolArrayDef"
        },
        {
          "$ref": "#/$defs/EnumArrayDef"
        }
      ]
    },
    "MeterDef": {
      "oneOf": [
        {
          "$ref": "#/$defs/F32MeterDef"
        },
        {
          "$ref": "#/$defs/F64MeterDef"
        },
        {
          "$ref": "#/$defs/I32MeterDef"
        },
        {
          "$ref": "#/$defs/U32MeterDef"
        },
        {
          "$ref": "#/$defs/BoolMeterDef"
        },
        {
          "$ref": "#/$defs/EnumMeterDef"
        },
        {
          "$ref": "#/$defs/F32ArrayDef"
        },
        {
          "$ref": "#/$defs/F64ArrayDef"
        },
        {
          "$ref": "#/$defs/I32ArrayDef"
        },
        {
          "$ref": "#/$defs/U32ArrayDef"
        },
        {
          "$ref": "#/$defs/U8ArrayDef"
        },
        {
          "$ref": "#/$defs/I8ArrayDef"
        },
        {
          "$ref": "#/$defs/I16ArrayDef"
        },
        {
          "$ref": "#/$defs/U16ArrayDef"
        },
        {
          "$ref": "#/$defs/BoolArrayDef"
        },
        {
          "$ref": "#/$defs/EnumArrayDef"
        }
      ]
    },
    "F32ParamDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "f32"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "I32ParamDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "i32"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        }
      }
    },
    "U32ParamDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "u32"
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "BoolParamDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool"
        }
      }
    },
    "EnumParamDef": {
      "type": "object",
      "required": ["kind", "values"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum"
        },
        "values": {
          "$ref": "#/$defs/EnumVocabulary"
        }
      }
    },
    "F32MeterDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "f32"
        }
      }
    },
    "F64MeterDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "f64"
        }
      }
    },
    "I32MeterDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "i32"
        }
      }
    },
    "U32MeterDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "u32"
        }
      }
    },
    "BoolMeterDef": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool"
        }
      }
    },
    "EnumMeterDef": {
      "type": "object",
      "required": ["kind", "values"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum"
        },
        "values": {
          "$ref": "#/$defs/EnumVocabulary"
        }
      }
    },
    "F32ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "f32.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "F64ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "f64.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "I32ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "i32.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "U32ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "u32.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "U8ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "u8.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "I8ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "i8.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "I16ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "i16.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "U16ArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "u16.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "BoolArrayDef": {
      "type": "object",
      "required": ["kind", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool.array"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    },
    "EnumArrayDef": {
      "type": "object",
      "required": ["kind", "values", "length"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum.array"
        },
        "values": {
          "$ref": "#/$defs/EnumVocabulary"
        },
        "length": {
          "$ref": "#/$defs/PositiveInteger"
        }
      }
    }
  }
}
