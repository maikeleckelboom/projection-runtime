{
  "name": "@exclave/session",
  "version": "0.0.0",
  "description": "Minimal binding validity fence. Answers whether an already-opened binding may be used for the expected authority key, grant key, and authority epoch.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --root ../.. --project @exclave/session",
    "test:watch": "vitest --root ../.. --project @exclave/session"
  },
  "dependencies": {},
  "devDependencies": {
    "@exclave/hot-codec": "workspace:*"
  }
}
