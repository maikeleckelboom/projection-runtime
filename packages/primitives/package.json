{
  "name": "@seqlok/primitives",
  "version": "0.0.0",
  "description": "Schema-free shared-memory mechanisms for Seqlok packages.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --root ../.. --project @seqlok/primitives",
    "test:watch": "vitest --root ../.. --project @seqlok/primitives"
  },
  "dependencies": {
    "@seqlok/base": "workspace:*"
  }
}
