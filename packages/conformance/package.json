{
  "name": "@exclave/conformance",
  "version": "0.0.0",
  "description": "Projection Runtime fixture conformance harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maikeleckelboom/projection-runtime.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/maikeleckelboom/projection-runtime#readme",
  "bugs": {
    "url": "https://github.com/maikeleckelboom/projection-runtime/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --root ../.. --project @exclave/conformance",
    "test:watch": "vitest --root ../.. --project @exclave/conformance"
  },
  "dependencies": {
    "@exclave/base": "workspace:*",
    "@exclave/compiler": "workspace:*",
    "@exclave/hot-binding": "workspace:*",
    "@exclave/hot-codec": "workspace:*",
    "@exclave/hot-publisher": "workspace:*",
    "@exclave/warm": "workspace:*"
  }
}
