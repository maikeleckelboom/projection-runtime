{
  "name": "@exclave/hot-consumer",
  "version": "0.0.0",
  "description": "Bounded hot-lane read attempts for already-opened Exclave sequence views.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --root ../.. --project @exclave/hot-consumer",
    "test:watch": "vitest --root ../.. --project @exclave/hot-consumer"
  },
  "dependencies": {
    "@exclave/base": "workspace:*"
  },
  "devDependencies": {
    "@exclave/hot-codec": "workspace:*"
  }
}
