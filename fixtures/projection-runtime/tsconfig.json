{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2024",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "isolatedDeclarations": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": "../..",
    "paths": {
      "@exclave/base": ["packages/base/src/index.ts"],
      "@exclave/schema": ["packages/schema/src/index.ts"],
      "@exclave/hot-codec": ["packages/hot-codec/src/index.ts"],
      "@exclave/hot-binding": ["packages/hot-binding/src/index.ts"],
      "@exclave/hot-consumer": ["packages/hot-consumer/src/index.ts"],
      "@exclave/hot-publisher": ["packages/hot-publisher/src/index.ts"],
      "@exclave/compiler": ["packages/compiler/src/index.ts"],
      "@exclave/conformance": ["packages/conformance/src/index.ts"]
    }
  },
  "include": ["**/generated/**/*.ts"],
  "exclude": ["../../node_modules", "../../packages/**/dist"]
}
