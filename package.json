{
  "name": "exclave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mts",
    "build": "tsc -b tsconfig.packages.json",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:tooling",
    "typecheck:packages": "tsc -b tsconfig.packages.json --pretty false",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm verify",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify": "node scripts/verify.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
