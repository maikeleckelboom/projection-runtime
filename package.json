{
  "name": "projection-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Electron-to-Rust architecture research for generated contracts, bounded publication, resource access, and lifecycle recovery.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maikeleckelboom/projection-runtime.git"
  },
  "homepage": "https://github.com/maikeleckelboom/projection-runtime#readme",
  "bugs": {
    "url": "https://github.com/maikeleckelboom/projection-runtime/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mts",
    "build": "tsc -b tsconfig.packages.json",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:tooling && pnpm typecheck:electron-rust-warm-authority && pnpm typecheck:electron-rust-resource",
    "typecheck:electron-rust-resource": "tsc -p integration/electron-rust-resource/tsconfig.json --pretty false",
    "build:electron-rust-resource": "node integration/electron-rust-resource/scripts/build.mts",
    "test:electron-rust-resource": "node integration/electron-rust-resource/scripts/run.mts",
    "measure:resource": "node --expose-gc integration/electron-rust-resource/scripts/measure.mts",
    "typecheck:packages": "tsc -b tsconfig.packages.json --pretty false",
    "typecheck:tooling": "tsc -p tsconfig.json --pretty false",
    "typecheck:electron-rust-warm-authority": "tsc -p integration/electron-rust-warm-authority/tsconfig.json --pretty false",
    "build:electron-rust-warm-authority": "node integration/electron-rust-warm-authority/scripts/build.mts",
    "test:electron-rust-warm-authority": "node integration/electron-rust-warm-authority/scripts/run-e2e.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm verify",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify": "node scripts/verify.mts",
    "lint:commits": "commitlint --last --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@types/node": "^25.7.0",
    "electron": "^43.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
